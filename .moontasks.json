{
  "targets": [
    {
      "name": "Game UI",
      "build": "true",
      "run": "cargo xtask game-run"
    },
    {
      "name": "OpenCity UI",
      "build": "cargo build -p opencity --no-default-features --features editor --bin editor",
      "run": "cargo editor"
    },
    {
      "name": "Game Map Editor",
      "build": "cargo build -p opencity --no-default-features --features editor --bin editor",
      "run": "OPENCITY_LAUNCH_ACTION=\"$PWD/opencity-launch.json\" cargo editor -- \"$PWD/data/maps/mtl/map.road\""
    },
    {
      "name": "Game Web",
      "build": "make build",
      "run": "make serve"
    },
    {
      "name": "Publish to Cloudflare Pages",
      "build": "cargo xtask web-deploy --dry-run",
      "run": "make web-deploy"
    },
    {
      "name": "OpenCity Web",
      "build": "make -C opencity build",
      "run": "make -C opencity serve"
    }
  ],
  "indent": {
    "spaces": 4
  },
  "day_ends_at": "16:30"
}

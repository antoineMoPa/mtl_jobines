    "dsl_recipe": {
      "subtree": {},
      "value": {
        "SceneDslRecipe": {
          "source": "# Independent vehicle study. X is length; front is negative X.\nunderbody = box(size: [3.85,0.23,1.55], at: [0,0.40,0], corner_radius: 0.08, color: \"#25282a\");\nbody = polygon_prism(vertices: [[-2.22,0.57],[-2.20,1.04],[-2.04,1.24],[-1.58,1.33],[-0.90,1.38],[0.80,1.37],[1.75,1.31],[2.18,1.16],[2.20,0.57]], depth: 1.38, color: \"#b5b4ae\");\n# Upper shoulder spans the wheel wells while the lower center remains narrow.\nshoulder = polygon_prism(vertices: [[-2.20,1.04],[-2.04,1.24],[-1.58,1.33],[-0.90,1.38],[0.80,1.37],[1.75,1.31],[2.18,1.16],[2.18,1.06]], depth: 1.73, color: \"#b5b4ae\");\n# Solid side panels include faceted arches that clear the wheels.\nobject side({}):\n panel = polygon_prism(vertices: [[-2.20,0.52],[-2.20,1.12],[-1.94,1.24],[-0.89,1.33],[1.73,1.28],[2.18,1.13],[2.18,0.53],[1.98,0.52],[1.90,0.84],[1.74,1.03],[1.40,1.06],[1.23,0.89],[1.14,0.52],[-1.12,0.52],[-1.20,0.88],[-1.37,1.06],[-1.73,1.06],[-1.91,0.89],[-1.99,0.52]], depth: 0.055, color: \"#b5b4ae\");\n archfront = bezier_curve(points: [[-1.99,0.52,0],[-1.96,0.83,0],[-1.85,1.10,0],[-1.70,1.10,0],[-1.50,1.13,0],[-1.30,1.10,0],[-1.22,0.92,0],[-1.17,0.80,0],[-1.14,0.65,0],[-1.14,0.52,0]], radius: 0.075, color: \"#25292a\");\n archrear = bezier_curve(points: [[1.14,0.52,0],[1.16,0.82,0],[1.24,1.10,0],[1.40,1.10,0],[1.58,1.14,0],[1.78,1.10,0],[1.87,0.94,0],[1.96,0.78,0],[1.99,0.65,0],[1.99,0.52,0]], radius: 0.075, color: \"#25292a\");\n sill = box(size: [2.25,0.15,0.07], at: [0,0.53,0.02], corner_radius: 0.04, color: \"#25292a\");\n door1 = bezier_curve(points: [[-0.84,1.29,0.04],[-0.78,1.12,0.04],[-0.75,0.84,0.04],[-0.73,0.61,0.04]], radius: 0.008, color: \"#747570\");\n door2 = bezier_curve(points: [[0.35,1.30,0.04],[0.39,1.09,0.04],[0.42,0.78,0.04],[0.42,0.61,0.04]], radius: 0.008, color: \"#747570\");\n door3 = bezier_curve(points: [[1.31,1.27,0.04],[1.36,1.15,0.04],[1.39,1.09,0.04],[1.40,1.07,0.04]], radius: 0.008, color: \"#747570\");\n handle1 = box(size: [0.28,0.045,0.035], at: [-0.20,1.18,0.06], corner_radius: 0.02, color: \"#d0d0c9\");\n handle2 = box(size: [0.27,0.045,0.035], at: [0.93,1.18,0.06], corner_radius: 0.02, color: \"#d0d0c9\");\nend\nplace(side(), at: [0,0,0.88]);\nplace(side(), at: [0,0,-0.88]);\n# cabin shell and dark window inset\nobject glass_side({}):\n glass = polygon_prism(vertices: [[-0.76,1.40],[-0.28,2.06],[0.07,2.12],[1.21,2.10],[1.47,2.02],[1.79,1.42]], depth: 0.035, color: \"#252d31\");\n b = box(size: [0.075,0.70,0.05], at: [0.35,1.77,0.03], rotation: [0,0,2], color: \"#171d20\");\n c = box(size: [0.065,0.66,0.05], at: [1.18,1.77,0.03], rotation: [0,0,12], color: \"#171d20\");\nend\nplace(glass_side(), at: [0,0,0.765]);\nplace(glass_side(), at: [0,0,-0.765]);\nwindshield = box(size: [0.035,0.94,1.38], at: [-0.66,1.75,0], rotation: [0,0,-38], color: \"#293136\");\nrearwindow = box(size: [0.035,0.71,1.36], at: [1.82,1.72,0], rotation: [0,0,24], color: \"#273034\");\nrail1 = box(size: [1.48,0.06,0.065], at: [0.55,2.26,0.62], corner_radius: 0.03, color: \"#252a2b\");\nrail2 = box(size: [1.48,0.06,0.065], at: [0.55,2.26,-0.62], corner_radius: 0.03, color: \"#252a2b\");\nobject wheel({}):\n tire = cylinder(radius: 0.39, height: 0.22, rotation: [90,0,0], color: \"#171a1b\");\n rim = cylinder(radius: 0.275, height: 0.235, rotation: [90,0,0], color: \"#303436\");\n hub = cylinder(radius: 0.075, height: 0.255, rotation: [90,0,0], color: \"#6b6e6d\");\nend\nplace(wheel(), at: [-1.57,0.46,0.89]);\nplace(wheel(), at: [-1.57,0.46,-0.89]);\nplace(wheel(), at: [1.56,0.46,0.89]);\nplace(wheel(), at: [1.56,0.46,-0.89]);\n# fascia and lighting\nuppergrille = box(size: [0.045,0.12,1.57], at: [-2.22,1.10,0], corner_radius: 0.025, color: \"#202427\");\ngrille = box(size: [0.05,0.31,1.22], at: [-2.235,0.88,0], corner_radius: 0.07, color: \"#343a3b\");\nlowergrille = box(size: [0.06,0.16,1.34], at: [-2.235,0.63,0], corner_radius: 0.04, color: \"#1b2021\");\nobject frontlamp({}):\n housing = box(size: [0.06,0.15,0.50], at: [-2.25,1.10,0], corner_radius: 0.035, color: \"#191f21\");\n led = box(size: [0.065,0.025,0.38], at: [-2.285,1.13,0], color: \"#d7ddd9\");\n amber = box(size: [0.07,0.09,0.045], at: [-2.29,1.09,0.21], color: \"#da8e26\");\nend\nplace(frontlamp(), at: [0,0,0.58]);\nplace(frontlamp(), at: [0,0,-0.58]);\nobject mirror({}):\n stalk = box(size: [0.13,0.10,0.18], at: [-0.74,1.39,0], color: \"#232829\");\n casing = box(size: [0.27,0.14,0.18], at: [-0.70,1.45,0.12], corner_radius: 0.045, color: \"#222728\");\nend\nplace(mirror(), at: [0,0,0.84]);\nplace(mirror(), at: [0,0,-1.08]);\ntail1 = box(size: [0.045,0.19,0.30], at: [2.19,1.21,0.62], color: \"#8c2928\");\ntail2 = box(size: [0.045,0.19,0.30], at: [2.19,1.21,-0.62], color: \"#8c2928\");\n# Faceted fascia inserts and grille perforation pattern.\nfrontfascia = box(size: [0.14,0.47,1.70], at: [-2.14,0.87,0], corner_radius: 0.06, color: \"#aeafa9\");\nfrontbumper = box(size: [0.17,0.22,1.65], at: [-2.13,0.68,0], corner_radius: 0.07, color: \"#aeafa9\");\nfrontlip = box(size: [0.12,0.09,1.68], at: [-2.14,0.52,0], corner_radius: 0.035, color: \"#222727\");\nrearbumper = box(size: [0.16,0.23,1.66], at: [2.12,0.66,0], corner_radius: 0.06, color: \"#aeadab\");\nrearlip = box(size: [0.13,0.11,1.64], at: [2.14,0.50,0], corner_radius: 0.04, color: \"#25292a\");\nobject vent({}):\n slot = box(size: [0.023,0.028,0.13], at: [-2.269,0,0], corner_radius: 0.01, color: \"#161b1c\");\nend\nplace(vent(), at: [0,0.79,-0.46]);\nplace(vent(), at: [0,0.79,-0.23]);\nplace(vent(), at: [0,0.79,0]);\nplace(vent(), at: [0,0.79,0.23]);\nplace(vent(), at: [0,0.79,0.46]);\nplace(vent(), at: [0,0.86,-0.52]);\nplace(vent(), at: [0,0.86,-0.30]);\nplace(vent(), at: [0,0.86,-0.08]);\nplace(vent(), at: [0,0.86,0.14]);\nplace(vent(), at: [0,0.86,0.36]);\nplace(vent(), at: [0,0.86,0.55]);\nplace(vent(), at: [0,0.93,-0.46]);\nplace(vent(), at: [0,0.93,-0.23]);\nplace(vent(), at: [0,0.93,0]);\nplace(vent(), at: [0,0.93,0.23]);\nplace(vent(), at: [0,0.93,0.46]);\nhoodline1 = bezier_curve(points: [[-1.97,1.25,0.52],[-1.65,1.34,0.54],[-1.20,1.38,0.59],[-0.94,1.39,0.61]], radius: 0.012, color: \"#d2d1ca\");\nhoodline2 = bezier_curve(points: [[-1.97,1.25,-0.52],[-1.65,1.34,-0.54],[-1.20,1.38,-0.59],[-0.94,1.39,-0.61]], radius: 0.012, color: \"#d2d1ca\");\nobject roof_rib({}):\n rib = box(size: [1.10,0.018,0.018], at: [0.50,2.25,0], corner_radius: 0.008, color: \"#d0d0ca\");\nend\nplace(roof_rib(), at: [0,0,0.24]);\nplace(roof_rib(), at: [0,0,-0.24]);\n# Native formed panels replace the slab roof and hood.\nroof_sheet = sheet_panel(size: [1.65,1.48], thickness: 0.075, bends: [bend(start: 0.68, radius: 0.35, angle: 12, direction: 90)], at: [0.50,2.19,0], rotation: [90,0,0], color: \"#c0c0ba\");\nhood_sheet = sheet_panel(size: [1.22,1.60], thickness: 0.075, bends: [bend(start: -0.46, radius: 0.40, angle: 9, direction: 0)], at: [-1.53,1.34,0], rotation: [90,0,0], color: \"#bdbdb7\");\n# Open glasshouse frame; windows have their material opacity set in the scene.\nobject pillars({}):\n a = bezier_curve(points: [[-0.90,1.36,0],[-0.72,1.62,0],[-0.50,1.94,0],[-0.32,2.13,0]], radius: 0.055, color: \"#b8b8b2\");\n c = bezier_curve(points: [[1.88,1.36,0],[1.74,1.64,0],[1.53,1.96,0],[1.31,2.13,0]], radius: 0.065, color: \"#b8b8b2\");\nend\nplace(pillars(), at: [0,0,0.72]);\nplace(pillars(), at: [0,0,-0.72]);\n# Eight simple opaque interior pieces positioned above the beltline.\nseat_fl = box(size: [0.48,0.10,0.53], at: [-0.05,1.41,0.35], corner_radius: 0.08, color: \"#4a4b49\");\nseat_fr = box(size: [0.48,0.10,0.53], at: [-0.05,1.41,-0.35], corner_radius: 0.08, color: \"#4a4b49\");\nback_fl = box(size: [0.12,0.48,0.53], at: [0.18,1.64,0.35], rotation: [0,0,-7], corner_radius: 0.07, color: \"#4a4b49\");\nback_fr = box(size: [0.12,0.48,0.53], at: [0.18,1.64,-0.35], rotation: [0,0,-7], corner_radius: 0.07, color: \"#4a4b49\");\nhead_fl = box(size: [0.12,0.15,0.28], at: [0.21,1.96,0.35], corner_radius: 0.05, color: \"#4a4b49\");\nhead_fr = box(size: [0.12,0.15,0.28], at: [0.21,1.96,-0.35], corner_radius: 0.05, color: \"#4a4b49\");\nbench = box(size: [0.50,0.11,1.25], at: [0.98,1.42,0], corner_radius: 0.07, color: \"#4a4b49\");\nbenchback = box(size: [0.13,0.47,1.25], at: [1.20,1.66,0], rotation: [0,0,-6], corner_radius: 0.06, color: \"#4a4b49\");\n",
          "scene_digest": "1d13fafd902eb209e94e794fb3d7355ba6135451d6b95f82b8e76bb5a4162d77"
        }
      }

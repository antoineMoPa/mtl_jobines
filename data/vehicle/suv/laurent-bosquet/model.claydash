    "dsl_recipe": {
      "subtree": {},
      "value": {
        "SceneDslRecipe": {
          "source": "# Compact crossover study. X is longitudinal; front is negative X.\n# Open arches are traced into the body silhouette; the polygon is extruded across the vehicle.\nbody = polygon_prism(vertices: [[-2.04,0.38],[-1.76,0.34],[-1.73,0.48],[-1.67,0.66],[-1.54,0.78],[-1.30,0.82],[-1.06,0.78],[-0.93,0.66],[-0.87,0.48],[-0.84,0.32],[0.85,0.32],[0.88,0.48],[0.95,0.66],[1.07,0.78],[1.31,0.82],[1.55,0.78],[1.67,0.66],[1.74,0.48],[1.77,0.34],[1.98,0.37],[2.02,0.91],[1.83,1.02],[1.45,1.08],[0.20,1.09],[-0.85,1.08],[-1.63,1.02],[-1.95,0.98],[-2.07,0.87]], depth: 1.50, color: \"#658aa7\");\nroof = polygon_prism(vertices: [[-0.50,1.68],[-0.34,1.76],[0.78,1.76],[1.20,1.68],[1.28,1.62],[0.78,1.70],[-0.34,1.70]], depth: 1.12, color: \"#658aa7\");\nobject wheel({}):\n  tire = cylinder(radius: 0.37, height: 0.22, rotation: [90,0,0], color: \"#161a1d\");\n  rim = cylinder(radius: 0.265, height: 0.235, rotation: [90,0,0], color: \"#afb7b8\");\n  cut1 = box(size: [0.11,0.12,0.40], at: [0,0.16,0], color: \"#21292b\");\n  cut2 = box(size: [0.11,0.12,0.40], at: [-0.152,0.049,0], rotation: [0,0,72], color: \"#21292b\");\n  cut3 = box(size: [0.11,0.12,0.40], at: [-0.094,-0.129,0], rotation: [0,0,144], color: \"#21292b\");\n  cut4 = box(size: [0.11,0.12,0.40], at: [0.094,-0.129,0], rotation: [0,0,216], color: \"#21292b\");\n  cut5 = box(size: [0.11,0.12,0.40], at: [0.152,0.049,0], rotation: [0,0,288], color: \"#21292b\");\n  hub = cylinder(radius: 0.075, height: 0.25, rotation: [90,0,0], color: \"#24292b\");\nend\nplace(wheel(), at: [-1.30,0.39,-0.81]);\nplace(wheel(), at: [1.31,0.39,-0.81]);\nplace(wheel(), at: [-1.30,0.39,0.81]);\nplace(wheel(), at: [1.31,0.39,0.81]);\nfront_grille = box(size: [0.06,0.30,1.23], at: [-2.07,0.58,0], corner_radius: 0.04, color: \"#161b1e\");\nlight_bar = bezier_curve(points: [[-2.05,0.94,-0.72],[-2.12,0.94,-0.38],[-2.12,0.94,0.38],[-2.05,0.94,0.72]], radius: 0.018, color: \"#e5f4f4\");\nfront_lower = box(size: [0.07,0.07,1.36], at: [-2.07,0.37,0], color: \"#333a3e\");\nrear_lamp = box(size: [0.05,0.055,1.35], at: [2.02,0.98,0], color: \"#b73936\");\nleft_sill = box(size: [2.15,0.14,0.055], at: [0,0.32,-0.81], color: \"#292f32\");\nright_sill = box(size: [2.15,0.14,0.055], at: [0,0.32,0.81], color: \"#292f32\");\nleft_mirror = box(size: [0.26,0.13,0.16], at: [-0.65,1.25,-0.92], corner_radius: 0.05, color: \"#658aa7\");\nright_mirror = box(size: [0.26,0.13,0.16], at: [-0.65,1.25,0.92], corner_radius: 0.05, color: \"#658aa7\");\nleft_handle1 = box(size: [0.19,0.035,0.035], at: [-0.33,0.94,-0.83], corner_radius: 0.015, color: \"#b1c4cc\");\nleft_handle2 = box(size: [0.19,0.035,0.035], at: [0.73,0.94,-0.83], corner_radius: 0.015, color: \"#b1c4cc\");\nright_handle1 = box(size: [0.19,0.035,0.035], at: [-0.33,0.94,0.83], corner_radius: 0.015, color: \"#b1c4cc\");\nright_handle2 = box(size: [0.19,0.035,0.035], at: [0.73,0.94,0.83], corner_radius: 0.015, color: \"#b1c4cc\");\nleft_front_lamp = box(size: [0.09,0.23,0.20], at: [-2.04,0.65,-0.66], color: \"#b9c3c4\");\nright_front_lamp = box(size: [0.09,0.23,0.20], at: [-2.04,0.65,0.66], color: \"#b9c3c4\");\nleft_rail = box(size: [1.65,0.045,0.05], at: [0.34,1.76,-0.52], corner_radius: 0.02, color: \"#24292b\");\nright_rail = box(size: [1.65,0.045,0.05], at: [0.34,1.76,0.52], corner_radius: 0.02, color: \"#24292b\");\n# Dark molded wheel-arch surrounds and dividing pillars.\narch_fl = torus(major_radius: 0.43, minor_radius: 0.055, at: [-1.30,0.39,-0.815], rotation: [90,0,0], color: \"#30373b\");\narch_rl = torus(major_radius: 0.43, minor_radius: 0.055, at: [1.31,0.39,-0.815], rotation: [90,0,0], color: \"#30373b\");\narch_fr = torus(major_radius: 0.43, minor_radius: 0.055, at: [-1.30,0.39,0.815], rotation: [90,0,0], color: \"#30373b\");\narch_rr = torus(major_radius: 0.43, minor_radius: 0.055, at: [1.31,0.39,0.815], rotation: [90,0,0], color: \"#30373b\");\npillar_l = box(size: [0.07,0.58,0.04], at: [0.22,1.40,-0.62], color: \"#161d20\");\npillar_r = box(size: [0.07,0.58,0.04], at: [0.22,1.40,0.62], color: \"#161d20\");\n# Individual side glazing leaves dark borders and pillars exposed.\nwindow_l_front = polygon_prism(vertices: [[-0.78,1.17],[-0.50,1.58],[-0.34,1.67],[0.14,1.67],[0.14,1.17]], depth: 0.018, at: [0,0,-0.603], color: \"#394b52\");\nwindow_r_front = polygon_prism(vertices: [[-0.78,1.17],[-0.50,1.58],[-0.34,1.67],[0.14,1.67],[0.14,1.17]], depth: 0.018, at: [0,0,0.603], color: \"#394b52\");\nwindow_l_rear = polygon_prism(vertices: [[0.28,1.17],[0.28,1.67],[0.77,1.67],[1.12,1.59],[1.34,1.35],[1.40,1.17]], depth: 0.018, at: [0,0,-0.603], color: \"#33434a\");\nwindow_r_rear = polygon_prism(vertices: [[0.28,1.17],[0.28,1.67],[0.77,1.67],[1.12,1.59],[1.34,1.35],[1.40,1.17]], depth: 0.018, at: [0,0,0.603], color: \"#33434a\");\n# Faceted shoulder crease follows the rising side character line.\ncrease_l = bezier_curve(points: [[-0.78,0.72,-0.758],[-0.15,0.75,-0.758],[0.55,0.80,-0.758],[1.12,0.96,-0.758]], radius: 0.007, color: \"#87a9bb\");\ncrease_r = bezier_curve(points: [[-0.78,0.72,0.758],[-0.15,0.75,0.758],[0.55,0.80,0.758],[1.12,0.96,0.758]], radius: 0.007, color: \"#87a9bb\");\n\n# Formed surface patches and a hollow passenger compartment.\nhood_skin = sheet_panel(size: [1.12,1.36], thickness: 0.025, bends: [bend(start: 0.35, radius: 0.25, angle: 8, direction: 0)], rotation: [90,0,0], at: [-1.46,1.065,0], color: \"#759ab4\");\nroof_skin = sheet_panel(size: [1.50,1.06], thickness: 0.025, bends: [bend(start: 0.45, radius: 0.20, angle: 8, direction: 0)], rotation: [90,0,0], at: [0.40,1.77,0], color: \"#759ab4\");\nwindshield = sheet_panel(size: [1.10,0.62], thickness: 0.012, rotation: [0,90,35], at: [-0.72,1.40,0], color: \"#57717b\");\nrear_glass = sheet_panel(size: [1.08,0.58], thickness: 0.012, rotation: [0,90,-40], at: [1.49,1.37,0], color: \"#57717b\");\nseat_front_l_cushion = box(size: [0.42,0.10,0.42], at: [-0.15,1.12,-0.30], corner_radius: 0.05, color: \"#30393e\");\nseat_front_l_back = box(size: [0.10,0.48,0.42], at: [0.03,1.36,-0.30], corner_radius: 0.04, color: \"#30393e\");\nseat_front_r_cushion = box(size: [0.42,0.10,0.42], at: [-0.15,1.12,0.30], corner_radius: 0.05, color: \"#30393e\");\nseat_front_r_back = box(size: [0.10,0.48,0.42], at: [0.03,1.36,0.30], corner_radius: 0.04, color: \"#30393e\");\nseat_rear_cushion = box(size: [0.45,0.10,0.95], at: [0.78,1.12,0], corner_radius: 0.04, color: \"#30393e\");\nseat_rear_back = box(size: [0.10,0.42,0.95], at: [1.00,1.32,0], corner_radius: 0.04, color: \"#30393e\");\nheadrest_l = box(size: [0.13,0.15,0.23], at: [0.03,1.64,-0.30], corner_radius: 0.04, color: \"#30393e\");\nheadrest_r = box(size: [0.13,0.15,0.23], at: [0.03,1.64,0.30], corner_radius: 0.04, color: \"#30393e\");\n",
          "scene_digest": "d7817c85e1264830b9a009be6ebc87a6bc13c18d6fd9b1adfd5368edb39d9ba6"
        }
      }

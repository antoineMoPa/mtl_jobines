# Permanent authoring reservations in the playable city's coordinates.
# These polygons protect existing grass; they do not add a flat terrain surface.
# Mountain: the full painted hill footprint, including slopes and summit.
mountain_park = vegetation(forest, 7.85,4.3, 7.4481,7.0, 6.35,8.9765, 4.85,9.7, 3.35,8.9765, 2.2519,7.0, 1.85,4.3, 2.2519,1.6, 3.35,-0.3765, 4.85,-1.1, 6.35,-0.3765, 7.4481,1.6);
# Parc Jarry: a large open block west of Jean-Talon and its metro station.
parc_jarry = vegetation(grass, -0.90,6.8, 1.10,6.8, 1.10,9.15, 0.70,9.15, -0.90,7.45);

# Inward interstate interchange: retain the bridge and four ramps serving the city.
# The outward interstate and its four ramp chains are removed.
road east_clover_exit_ramp:
    verge carlane verge;
    direction forward;
    role ramp;
end

road east_clover_interstate_three_lane:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

# One lane each way on the city-bound branch, matching its terminal ramps and city street.
road east_clover_city_interstate:
    verge carlane middle carlane verge;
    role highway;
end

road east_clover_interstate_core:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

road east_clover_ramp_mouth:
    verge carlane verge;
    direction forward;
    role merge;
end


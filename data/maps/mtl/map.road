# The first band adds 3.5 m of paved shoulder toward the highway interior.
# Shift the ramp deck inward by half that width to keep its wall-side edge fixed.
road access_ramp:
    verge carlane;
    direction forward;
    role ramp;
end

road access_mouth:
    verge carlane;
    direction forward;
    role merge;
end


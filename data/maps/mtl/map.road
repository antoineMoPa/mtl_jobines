# Local wayfinding beside the stadium, rather than an out-of-map city destination.
road_path(ring_east_1_right_in, "Hochelaga", "Stade");
sign_hochelaga_stadium=prop(highway_sign,29.205,11.55,{heading:0,elevation:0.102001,destination:"Hochelaga",secondary:"Stade",exit:"",arrow:right});

# Underground metro loop: authored cubic centreline, platforms and stair excavations.
# Entire loop stays inside the interstate ring; the return curve clears its inward spur.
road metro_track:
    subwaytrack;
end
road metro_platform:
    sidewalk;
end
road metro_stair:
    sidewalk;
end
metro_loop_00 = metro_track(1.3, 1.4, 1.3, 3.6, 1.3, 5.8, 1.3, 8);
grade(metro_loop_00, -0.0365, -0.0365);

# City coordinates: +X east, +Y north. The airport is west of the island.
# Existing road IDs are stable references; use coordinates for compass directions.
# The frame extends 48.05 units (4.8 km) further south, in whole pixels, for the South Shore.
elevation_map("elevation.png", -76.8, -124.84692082, 153.6, 153.6, -0.18, 1.2);

water_level(0);

player_start(-0.94828856, -1.1318498, -170.17438820378175);
# TEMPORARY: begin mounted on the bicycle at player_start while testing.
# pedestrian_start(1.6698667, -2.1649537, -210.95461);

# Starting point and westward bearing for finding the three boat moorings.
boat_start(-0.94828856, -1.1318498, -180);

# Bus stops; taxi stops are selected from the current road network at runtime.
# Sidewalk outside the residential block; return at the front of district_home_241.
mission_missing_cat = map_point(14.32, -13.20);
mission_cat_duplex = map_point(13.35, -14.67);

mission_bus_stop_1 = map_point(-0.63, -2.0);
mission_bus_stop_2 = map_point(-0.59, -3.5);
mission_bus_stop_3 = map_point(-0.54, -5.0);
mission_bus_sign_1 = prop(bus_stop_sign, -0.69, -2.0, { heading: -90, elevation: 0.102 });
mission_bus_sign_2 = prop(bus_stop_sign, -0.65, -3.5, { heading: -90, elevation: 0.102 });
mission_bus_sign_3 = prop(bus_stop_sign, -0.60, -5.0, { heading: -90, elevation: 0.102 });

block terrain_source:
    # Local soft hill; the elevation bake follows the road grades inside this footprint.
    road_hill = terrain(0.4, 4.3, -7.85, 7.0, -7.4481, 8.9765, -6.35, 9.7, -4.85, 8.9765, -3.35, 7.0, -2.2519, 4.3, -1.85, 1.6, -2.2519, -0.3765, -3.35, -1.1, -4.85, -0.3765, -6.35, 1.6, -7.4481);
    # Coastal bank follows the ring; offshore terrain stays below water_level.
    # elevation.png retains the existing road-shaped inland hill samples.
    # The western coast joins both runway corners to the mainland.
    island = land(2, 15.6, 8, 15.6, 16, 15.6, 21, 15.6, 25, 14.5, 27.3, 10, 27.3, 0, 27.3, -14, 27.3, -25, 25, -29.5, 21, -31.1, 12, -31.1, 4, -31.1, -0.9, -28.8, -12.6, -20.4, -21.4, -5.8, -21.8, -5.12, -21.8, -4.4, -21.8, 4.4, -21.8, 5.12, -21.2, 5.5, -10.6, 12.2, 0.4, 15);
    # Join the mainland bank to the reclaimed airport platform beside the access road.
    airport_bank = land(1, 5.6, 1, -5.6, -7, -5.6, -7, 5.6);
    # South Shore plateau and sloped banks are baked into elevation.png.
    south_shore_land = land(-0.5, -38, 2.5, -36.4, 7.5, -36.1, 10.5, -36.3, 12, -35.9, 14.5, -36.4, 20.5, -36.8, 26.5, -39, 27.5, -45, 28.5, -55, 28, -68, 26.5, -80, 24, -91, 18, -98, 9, -99.5, 2.5, -97, -5, -96, -11, -91, -12, -84, -9, -77, -2.5, -70, -2.5, -60, -1.5, -45);
    # Southwest ski hill: broad lower slopes around a compact 110m summit.
    ski_hill_lower = terrain(0.52, -8.5, -85.5, -7, -79, -2, -77.5, 2.5, -80, 4.5, -85.5, 2, -91, -3, -93, -7, -90);

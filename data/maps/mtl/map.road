# Southern city ring: a 300 m radius turn from southbound to eastbound.
# The east-facing shared endpoint continues into the southern leg below.
city_ring_north_bend_end = map_point(3.478629583, -27.909175617);
city_ring_north_end = map_point(5.477751096, -27.849903561);
city_ring_east_bend = east_clover_interstate_three_lane(east_clover_ew_e9, 0.440141808, -26.655527919, 1.822503097, -27.958278197, city_ring_north_bend_end);
grade(city_ring_east_bend, 0.102001, 0.102001);
city_ring_north_approach = east_clover_interstate_three_lane(city_ring_north_bend_end, 4.145003421, -27.889418265, 4.811377258, -27.869660913, city_ring_north_end);
grade(city_ring_north_approach, 0.102001, 0.102001);


# Report 72: north leg, south leg and a straight eastern connector.
# Five access sites retain both carriageway connections; frontage roads end at their ramp joins.
# Outward dead-end spurs and unused frontage tails are removed.
# All eastern pavement stays west of the report's x=36.01067 limit.
road ring_service:
    carlane sidewalk;
    direction forward;
end
ring_west_join = map_point(-0.625448471, 9.285553352);
ring_west_vertical = map_point(2.374551529, 12.285553352);
ring_west_top = map_point(21.000000000, 12.285553352);

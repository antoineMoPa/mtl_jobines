grade(ring_west_lower_bend, 0.102001000, 0.102001000);
ring_west_depart = lane_point(ring_west_lower_bend, 5, 0);
ring_west_return = lane_point(ring_west_lower_bend, 3, 0);
ring_west_out = east_clover_approach(highway_south_west, -0.464686515, 8.756084908, -0.582580661, 9.020707452, ring_west_depart);
grade(ring_west_out, 0.117662384, 0.102001000);
ring_west_in = east_clover_approach(ring_west_return, -0.652549914, 9.018632930, -0.754559148, 8.747490909, highway_north_west);
grade(ring_west_in, 0.102001000, 0.117662384);


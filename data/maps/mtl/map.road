metro_loop_08 = metro_track(20.2, 7.55, 8, 7.55, 12, 0.4, 1.8, 0.4);
grade(metro_loop_08, -0.0365, -0.0365);
metro_loop_09 = metro_track(1.8, 0.4, 1.523858, 0.4, 1.3, 0.623858, 1.3, 0.9);

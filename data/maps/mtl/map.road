road south_clover_exit_ramp:
    verge carlane verge;
    direction forward;
    role ramp;
end

road south_clover_interstate_three_lane:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

road south_clover_interstate_core:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

road south_clover_ramp_mouth:
    verge carlane verge;
    direction forward;
    role merge;
end


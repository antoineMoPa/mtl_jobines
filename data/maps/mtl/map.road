road service_north:
    carlane carlane sidewalk;
    direction forward;
end

road service_south:
    carlane carlane sidewalk;
    direction forward;
end

road highway_forward:
    verge carlane carlane carlane verge verge verge;
    direction forward;
    role highway;
end

road highway_reverse:
    verge carlane carlane carlane verge verge verge;
    direction forward;
    role highway;
end

road highway_median:
    barrier;
end

road cross_street:
    sidewalk carlane middle carlane sidewalk;
end

# Paired curbside bike lanes on the local and full-length district cycling corridors.

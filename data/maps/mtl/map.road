# Larger enclosed Alpine beside the original Motoneige; 5m centre spacing leaves boarding room.
parked_vehicle("vehicle-winter-alpine-340", 4.1, -82.35, 180);

# Winter ski equipment beside the Chalet lift loading lane and summit exit. F equips on foot.
ski_set(3.776, -82.545, 203.43);

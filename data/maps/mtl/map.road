# Underground metro loop: authored cubic centreline, platforms and stair excavations.
# Entire loop stays inside the interstate ring; the return curve clears its inward spur.
road metro_track:
    subwaytrack;
end
road metro_platform:
    sidewalk;
end
road metro_stair:
    sidewalk;
end
metro_loop_00 = metro_track(1.4, -1.3, 3.6, -1.3, 5.8, -1.3, 8, -1.3);
grade(metro_loop_00, -0.0365, -0.0365);
metro_loop_01 = metro_track(8, -1.3, 8.15, -1.3, 8.3, -1.3, 8.45, -1.3);
grade(metro_loop_01, -0.0365, -0.0365);

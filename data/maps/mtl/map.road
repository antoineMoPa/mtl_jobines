grade(airport_access, 0.1020, 0.102001);

# Terminal turnaround. Lane 3 arrives westbound and lane 1 returns to the city.
# The outer sidewalk joins both approach sidewalks and stays east of the apron.
road turnaround_lane:
    carlane sidewalk;
    direction forward;
end
airport_loop_entry = lane_point(airport_access, 3, 1);
airport_loop_exit = lane_point(airport_access, 1, 1);
airport_loop_north = map_point(-3.828, -0.36);
airport_loop_west = map_point(-3.928, -0.46);
airport_loop_south = map_point(-3.828, -0.56);
airport_loop_enter = turnaround_lane(airport_loop_entry, -3.76, -0.425, -3.773, -0.36, airport_loop_north);
airport_loop_nw = turnaround_lane(airport_loop_north, -3.88323, -0.36, -3.928, -0.40477, airport_loop_west);
airport_loop_sw = turnaround_lane(airport_loop_west, -3.928, -0.51523, -3.88323, -0.56, airport_loop_south);
airport_loop_leave = turnaround_lane(airport_loop_south, -3.773, -0.56, -3.76, -0.495, airport_loop_exit);
grade(airport_loop_enter, 0.102001, 0.102001);
grade(airport_loop_nw, 0.102001, 0.102001);
grade(airport_loop_sw, 0.102001, 0.102001);
grade(airport_loop_leave, 0.102001, 0.102001);
parked_vehicle("vehicle-air-estuaire", -4.79, -0.87, -90);
parked_vehicle("vehicle-air-fleche", -4.86, 0.81, -90);
parked_vehicle("vehicle-airport-baggage-tractor", -4.36, -0.48, 180);

# Baggage trailer axle targets, parallel to the terminal and YULPET airliner fuselage.
mission_baggage_dispatch = map_point(-4.53, 0.30);
mission_baggage_aircraft = map_point(-4.85, -0.99);


# South Shore: separate land across the river, with a bridge landing and the autoroute continuing south.


road champlain_approach:
    carlane carlane carlane verge;
    direction forward;
    role highway;
end

road champlain_carriageway:
    carlane carlane carlane;
    direction forward;
    role highway;
end

# Local model X runs south. Across-road geometry is widened 1.4x for 4.5m game lanes.
# GLB water datum z=0, asphalt z=24m. Pavement sits 2cm above it; structural strips stay clear.
champlain_model = building(1.11, "models/champlain-bridge.glb", { collision: none }, 11.72, -30.9, 11.72, -36.1, 12.28, -36.1, 12.28, -30.9);
elevation(champlain_model, -0.02);

champlain_north_southbound = map_point(11.7984, -30.9);
champlain_north_northbound = map_point(12.2016, -30.9);
champlain_south_southbound = map_point(11.7984, -36.1);
champlain_south_northbound = map_point(12.2016, -36.1);
champlain_city_depart = lane_point(south_clover_i_ns_02a, 3, 0);
champlain_city_return = lane_point(south_clover_i_ns_02a, 5, 0);
champlain_city_out = champlain_approach(champlain_city_depart, 11.965, -30.22, 11.7984, -30.63, champlain_north_southbound);
grade(champlain_city_out, 0.168001, 0.2402);
champlain_city_in = champlain_approach(champlain_north_northbound, 12.2016, -30.63, 12.035, -30.22, champlain_city_return);
grade(champlain_city_in, 0.2402, 0.168001);
champlain_southbound = champlain_carriageway(champlain_north_southbound, 11.7984, -32.633333333, 11.7984, -34.366666667, champlain_south_southbound);
elevation(champlain_southbound, 0.2402);
champlain_northbound = champlain_carriageway(champlain_south_northbound, 12.2016, -34.366666667, 12.2016, -32.633333333, champlain_north_northbound);
elevation(champlain_northbound, 0.2402);

# South landing: full-length grade down to the local boulevard, no step at either end.
south_shore_highway_end = map_point(12, -39);
south_shore_highway_start = map_point(12, -38);
south_shore_boulevard_end = map_point(12, -47);
south_shore_node_2 = map_point(12, -57);

highway_east_climb_cut = terrain_cut(-0.000000333337, { slope_x: 0.033319137655, slope_y: 0.000987829145 }, 7.015659429, -0.424781151, 10.014371823, -0.335876825, 9.997628342, 0.228875028, 6.998915948, 0.139970702);


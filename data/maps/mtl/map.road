elevation(south_shore_highway, 0.102001);
south_shore_entry = lane_point(south_shore_highway, 3, 1);
south_shore_exit = lane_point(south_shore_highway, 5, 1);
champlain_shore_out = champlain_approach(champlain_south_southbound, 11.7984, -36.733333333, 11.965, -37.366666667, south_shore_entry);
grade(champlain_shore_out, 0.2402, 0.102001);
champlain_shore_in = champlain_approach(south_shore_exit, 12.035, -37.366666667, 12.2016, -36.733333333, champlain_south_northbound);
grade(champlain_shore_in, 0.102001, 0.2402);
south_shore_boulevard = east_clover_interstate_three_lane(south_shore_highway_end, 12, -41.666666667, 12, -44.333333333, south_shore_boulevard_end);
elevation(south_shore_boulevard, 0.102001);

# The autoroute continues south as a chain of three-lane segments (1 unit = 100 m).
south_shore_autoroute_1 = east_clover_interstate_three_lane(south_shore_boulevard_end, 12, -50.333333333, 12, -53.666666667, south_shore_node_2);
elevation(south_shore_autoroute_1, 0.102001);
south_shore_autoroute_2 = east_clover_interstate_three_lane(south_shore_node_2, 12, -60.333333333, 12, -63.666666667, south_shore_node_3);
elevation(south_shore_autoroute_2, 0.102001);
south_shore_autoroute_3 = east_clover_interstate_three_lane(south_shore_node_3, 12, -70.333333333, 12, -73.666666667, south_shore_node_4);
elevation(south_shore_autoroute_3, 0.102001);
# Short through pieces locate interchange mouths without changing the autoroute alignment.
ski_main_north = map_point(12, -80);
ski_main_center = map_point(12, -82);
ski_main_south = map_point(12, -84);
south_shore_autoroute_4 = east_clover_interstate_three_lane(south_shore_node_4, 12, -78, 12, -79, ski_main_north);
elevation(south_shore_autoroute_4, 0.102001);

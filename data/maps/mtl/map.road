grade(metro_loop_05, -0.0365, -0.0365);
metro_loop_06 = metro_track(21, 8.45, 21, 8.416667, 21, 8.383333, 21, 8.35);
grade(metro_loop_06, -0.0365, -0.0365);
metro_loop_07 = metro_track(21, 8.35, 21, 7.908172, 20.641828, 7.55, 20.2, 7.55);

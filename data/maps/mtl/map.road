# Complete the western climb through the existing excavation (bug report 65).
# Separate placements preserve the ramp attachments on the original highway.
# The pavement stays 0.002 above the cut; all six lanes share the existing seam refs.
highway_north_west = map_point(-8.481607748, -0.746675964);
highway_south_west = map_point(-8.490201747, -0.456803331);
highway_median_west = map_point(-8.485904747, -0.601739648);

highway_north_climb = highway_forward(highway_north_west, -7.482043614, -0.717041386, -6.482479480, -0.687406809, highway_north_start);
grade(highway_north_climb, 0.117662384, 0.002);

highway_south_climb = highway_reverse(highway_south_end, -6.491073479, -0.397534176, -7.490637613, -0.427168753, highway_south_west);

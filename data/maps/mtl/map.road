elevation(ski_main_b, 0.102001);
ski_main_c = east_clover_interstate_three_lane(ski_main_south, 12, -85, 12, -86, south_shore_node_5);
elevation(ski_main_c, 0.102001);
south_shore_autoroute_5 = east_clover_interstate_three_lane(south_shore_node_5, 12, -89.666666667, 12, -92.333333333, south_shore_node_end);
elevation(south_shore_autoroute_5, 0.102001);

# Autoroute end: one U-turn per lane pair (inner, middle, outer) so southbound traffic returns north.
road south_shore_turnaround_lane:
    carlane;
    direction forward;
end
south_shore_turn_in_1 = lane_point(south_shore_autoroute_5, 5, 1);
south_shore_turn_out_1 = lane_point(south_shore_autoroute_5, 3, 1);
south_shore_turn_in_2 = lane_point(south_shore_autoroute_5, 6, 1);
south_shore_turn_out_2 = lane_point(south_shore_autoroute_5, 2, 1);
south_shore_turn_in_3 = lane_point(south_shore_autoroute_5, 7, 1);
south_shore_turn_out_3 = lane_point(south_shore_autoroute_5, 1, 1);
south_shore_turn_inner = south_shore_turnaround_lane(south_shore_turn_in_1, 11.965, -95.12, 12.035, -95.12, south_shore_turn_out_1);
south_shore_turn_middle = south_shore_turnaround_lane(south_shore_turn_in_2, 11.8975, -95.16, 12.1025, -95.16, south_shore_turn_out_2);
south_shore_turn_outer = south_shore_turnaround_lane(south_shore_turn_in_3, 11.83, -95.2, 12.17, -95.2, south_shore_turn_out_3);
elevation(south_shore_turn_inner, 0.102001);
elevation(south_shore_turn_middle, 0.102001);
elevation(south_shore_turn_outer, 0.102001);


# Local shoulders stay open; only the autoroute retains automatic barriers.
road ski_local_road:
    verge carlane middle carlane verge;
    role highway;
end
road ski_local_mouth:
    verge carlane verge;
    direction forward;
    role merge;
end
road_barriers(ski_local_road, none);
road_barriers(ski_local_mouth, none);
road_barriers(ski_circle_lane, none);

# Single far-side roundabout serves the hill and both autoroute directions.
# Counterclockwise circulation on the east side; the hill road crosses the highway directly.
road ski_circle_lane:
    verge carlane verge;
    direction forward;
    role ramp;
end



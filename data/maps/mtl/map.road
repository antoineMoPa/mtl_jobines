# Report 70: OpenCity road_library/cloverleaf.road, rotated to the interstate.
# Preserve all eight ramp chains; use game-scale deck heights and rounded crests.
# The crossing deck is 8 m above the approaches; connector crests are 13 m above them.
# Replace the west stub with
# directional three-lane connections to the eastern climb crest.
road east_clover_exit_ramp:
    verge carlane verge;
    direction forward;
    role ramp;
end

road east_clover_interstate_three_lane:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

road east_clover_interstate_core:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

road east_clover_ramp_mouth:
    verge carlane verge;
    direction forward;
    role merge;
end


# Eastern city ring: a 300 m radius turn from eastbound to northbound.
# The north-facing shared endpoint continues into the eastern leg below.
city_ring_north_bend_end = map_point(27.909175617, 3.478629583);
city_ring_north_end = map_point(27.849903561, 5.477751096);
city_ring_east_bend = east_clover_interstate_three_lane(east_clover_ew_e9, 26.655527919, 0.440141808, 27.958278197, 1.822503097, city_ring_north_bend_end);
grade(city_ring_east_bend, 0.102001, 0.102001);
city_ring_north_approach = east_clover_interstate_three_lane(city_ring_north_bend_end, 27.889418265, 4.145003421, 27.869660913, 4.811377258, city_ring_north_end);
grade(city_ring_north_approach, 0.102001, 0.102001);


# Report 72: west leg, east leg and a straight northern connector.
# Five access sites after annotated feedback; the second east-leg site is removed.
# All northern pavement stays south of the report's y=36.01067 limit.
road ring_service:
    carlane sidewalk;
    direction forward;
end
ring_west_join = map_point(-9.285553352, -0.625448471);
ring_west_vertical = map_point(-12.285553352, 2.374551529);
ring_west_top = map_point(-12.285553352, 21.000000000);
ring_north_west = map_point(-9.285553352, 24.000000000);
ring_east_top = map_point(27.750000000, 21.000000000);
ring_north_east = map_point(24.750000000, 24.000000000);
ring_west_lower_bend = east_clover_interstate_three_lane(ring_west_join, -10.941679839, -0.674551050, -12.285553352, 0.717697280, ring_west_vertical);
grade(ring_west_lower_bend, 0.102001000, 0.102001000);
ring_west_depart = lane_point(ring_west_lower_bend, 5, 0);
ring_west_return = lane_point(ring_west_lower_bend, 3, 0);
ring_west_out = east_clover_approach(highway_south_west, -8.756084908, -0.464686515, -9.020707452, -0.582580661, ring_west_depart);
grade(ring_west_out, 0.117662384, 0.102001000);
ring_west_in = east_clover_approach(ring_west_return, -9.018632930, -0.652549914, -8.747490909, -0.754559148, highway_north_west);
grade(ring_west_in, 0.102001000, 0.117662384);


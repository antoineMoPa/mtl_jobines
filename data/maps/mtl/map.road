# Paired fuel stations sit flush with the hill-road shoulders.
# The road is 0.185 units wide; each concrete front edge meets its outer edge.
# Direct forecourt access avoids a separate road through the station signs.
# Reuse the existing GLB and its shop/pump collision volumes; forecourt remains open.
block ski_fuel_station:
    forecourt = concrete(-0.05, 0, 0.503, 0, 0.503, 0.357325, -0.05, 0.357325);
    elevation(forecourt, 0.121001);
    model = building(0.108, "models/fuel-station.glb", { collision: none }, 0, 0, 0.453, 0, 0.453, 0.317325, 0, 0.317325);
    elevation(model, 0.10025);
    shop = building(0.0612, "plinth", { material: concrete }, 0.084300001, 0.205875000, 0.368700001, 0.205875000, 0.368700000, 0.305775000, 0.084300000, 0.305775000);
    elevation(shop, 0.104150);
    pump_island_a = building(0.0036, "plinth", { material: concrete }, 0.187050000, 0.066375000, 0.217950001, 0.066375000, 0.217950000, 0.175275001, 0.187050000, 0.175275000);
    elevation(pump_island_a, 0.101150);
